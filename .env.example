# ===== 项目通用 =====
APP_NAME=乡音守护者
APP_ENV=dev          # dev / prod
LOG_LEVEL=INFO

# ===== 路径（不要硬编码到代码里）=====
PROJECT_ROOT=D:\python_demo\乡音守护者
MODELS_DIR=D:\python_demo\乡音守护者\models
DATA_DIR=D:\python_demo\乡音守护者\data

# ===== ASR =====
ASR_MODEL_SIZE=large-v3      # tiny/base/small/medium/large-v3
ASR_LANGUAGE=zh
ASR_INITIAL_PROMPT=以下是萍乡话普通话夹杂的普通话转写文本。

# ===== TTS =====
TTS_MODEL_NAME=piper
TTS_VOICE=zh_CN-huayan-medium
TTS_DEVICE=cpu              # cuda / cpu

# ===== LLM =====
LLM_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_LORA_WEIGHTS=          # 阶段 4 填
LLM_DEVICE=cuda            # cuda / cpu
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.7

# ===== RAG =====
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_VECTOR_DIR=./data/chroma
RAG_TOP_K=4

# ===== 数据库（语料元数据）=====
DB_URL=sqlite:///./data/xiangyin.db

# ===== 外部 API（可选，占位）=====
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=        # 阿里通义，用于阶段调试
